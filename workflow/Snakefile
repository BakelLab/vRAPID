rule run_clair3:
    message: "Run Clair3 on final ref BAM"
    input:
        sorted_rg_bam = "{sample}/02_assembly/{sample}_ref.sorted.rg.bam",
        model         = "ilmn"
    output:
        vcf           = "{sample}/02_assembly/clair3/merge_output.vcf.gz",
        folder        = directory("{sample}/02_assembly/clair3")
    params:
        samples       = "{sample}"
    log:
        "logs/{sample}/02_assembly/06_run-clair3.snakemake.log"
    container: "docker://hkubal/clair3:v1.2.0"
    shell:
        """
        run_clair3.sh --bam_fn={input.sorted_rg_bam} \
             --ref_fn={config[reference_genome]} \
             --threads={threads} \
             --platform=ilmn \
             --model_path=./ilmn \
             --output={output.folder} \
             --include_all_ctgs > {log} 2>&1
        """


rule get_masking_sites:
    message: "Get masking sites for low coverage regions"
    input:
        sorted_rg_bam = "{sample}/02_assembly/{sample}_ref.sorted.rg.bam",
    output:
       mask_sites     = "{sample}/02_assembly/{chromosomes}_coverage_mask.txt"
    params:
        depth_masking = os.path.join(workflow.basedir, "../workflow/scripts/02_generate-depth-masking.py")
    log:
        "logs/{sample}/02_assembly/07_{chromosomes}.get-masking-sites.snakemake.log"
    conda:
        "envs/env.yml"
    shell:
        """
        python {params.depth_masking} --depth {config[depth]} {config[reference_genome]} {input.sorted_rg_bam} {output.mask_sites}
        """


rule generate_preconsensus_sequence:
    message: "Use coverage information to generate preconsensus sequence"
    input:
        vcf        = "{sample}/02_assembly/clair3/merge_output.vcf.gz",
        mask_sites = "{sample}/02_assembly/{chromosomes}_coverage_mask.txt"
    output:
        fasta      = "{sample}/02_assembly/{chromosomes}_preconsensus.fasta"
    params:
        mask       = os.path.join(workflow.basedir, "../workflow/scripts/02_mask-to-preconsensus.py")
    log:
        "logs/{sample}/02_assembly/08_{chromosomes}.generate-preconsensus-sequence.snakemake.log"
    conda:
        "envs/env.yml"
    shell:
         """
         bcftools index {input.vcf}
         python {params.mask} {config[reference_genome]} {input.mask_sites} {input.vcf} {output.fasta}
         """


rule polish_consensus:
    message: "Polish sequence for each header in reference FASTA"
    input:
        vcf         = "{sample}/02_assembly/clair3/merge_output.vcf.gz",
        fasta       = "{sample}/02_assembly/{chromosomes}_preconsensus.fasta"
    output:
        fasta       = "{sample}/02_assembly/{chromosomes}_polished.fasta",
        normalised  = "{sample}/02_assembly/{chromosomes}_normalised.vcf.gz"
    params:
        chromosomes = "{chromosomes}",
    log:
        "logs/{sample}/02_assembly/09_{chromosomes}.polish-consensus.snakemake.log"
    conda:
        "envs/env.yml"
    shell:
        """
        bcftools norm -f {config[reference_genome]} -m-any -o {output.normalised} {input.vcf} >> {log} 2>&1
        bcftools index {output.normalised} >> {log} 2>&1
        bcftools consensus -f {config[reference_genome]} -o {output.fasta} {output.normalised} >> {log} 2>&1
        """ 


rule concatenate_FASTAs:
    message: "Concatenate all headers into one FASTA per sample with chromosome name appended"
    input:
        lambda wildcards: expand("{sample}/02_assembly/{chromosomes}_polished.fasta", 
                                 sample = wildcards.sample, 
                                 chromosomes = chromosomes)
    output:
        fasta = "{sample}/02_assembly/{sample}.fasta"
    log:
        "logs/{sample}/02_assembly/10_FASTA-concatenation.snakemake.log"
    shell:
        """
        for fasta in {input}; do
            chrom=$(basename "$fasta" | cut -d'_' -f1)
            awk -v c="$chrom" '{{if($0 ~ /^>/) {{$0 = $0 "_" c}} print}}' "$fasta"
        done > {output.fasta}
        """

    
rule run_mpileup:
    message: "Run samtool's mpileup"
    input:
        fasta  = "{sample}/02_assembly/{sample}.fasta",
        bam    = "{sample}/02_assembly/{sample}_ref.sorted.rg.bam",
    output:
        pileup = "{sample}/04_variants/{chromosomes}_pileup"
    log:
        "logs/{sample}/04_variants/01_{chromosomes}_mpileup.snakemake.log"
    conda:
        "envs/env.yml"
    shell:
        """
        samtools mpileup -f {config[reference_genome]} -r {wildcards.chromosomes} {input.bam} -o {output.pileup}
        """    


rule process_pileup:
    message: "Process pileup output to get variable bases TSV"
    input:
        pileup        = "{sample}/04_variants/{chromosomes}_pileup",
        vcf           = "{sample}/02_assembly/clair3/merge_output.vcf.gz"
    output:
        tsv           = "{sample}/04_variants/{chromosomes}_variable_bases.tsv"
    params:
        sample_folder = "{sample}",
        outdir        = "{sample}/04_variants",
        chrom         = "{chromosomes}",
        min_ratio     = 0.9,
        pileup_script = os.path.join(workflow.basedir, "../workflow/scripts/04_process-pileup.py")
    log:
        "logs/{sample}/04_variants/02_{chromosomes}.process_pileup.snakemake.log"
    conda:
        "envs/env.yml"
    shell:
        """
        python {params.pileup_script} \
            --sample_folder {params.sample_folder} \
            --chrs {params.chrom} \
            --outdir {params.outdir} \
            --min_ratio {params.min_ratio} \
            --primer_set {config[primer_file]} \
            --vcf {input.vcf} 2> {log}
        """


rule run_bamtools_split:
    message: "Run bamtools split"
    input:
        sorted_rg_bam = "{sample}/02_assembly/{sample}_ref.sorted.rg.bam",
        tsv           = "{sample}/04_variants/{chromosomes}_variable_bases.tsv"
    output:
        mapped        = temp("{sample}/02_assembly/{sample}_ref.sorted.REF_{chromosomes}.bam")
    log:
        "logs/{sample}/02_assembly/10_{chromosomes}.bamtools-split.snakemake.log"
    conda:
        "envs/env.yml"
    shell:
        """
        bamtools split -in {input.sorted_rg_bam} -reference > {log} 2>&1        
        """
        

rule run_picard_insert_metrics:
    message: "Get insert metrics using Picard"
    input:
        fasta         =  "{sample}/02_assembly/{sample}.fasta",
        sorted_rg_bam = "{sample}/02_assembly/{sample}_ref.sorted.rg.bam",
        mapped        = expand("{sample}/02_assembly/{sample}_ref.sorted.REF_{chromosomes}.bam", 
                                 sample = sampleids, chromosomes = chromosomes)
    output:
        txt           = temp("{sample}/02_assembly/{sample}_insert_size_metrics.txt"),
        pdf           = temp("{sample}/02_assembly/{sample}_insert_size_histogram.pdf"),
    log:
        "logs/{sample}/02_assembly/11_picard-insert-metrics.snakemake.log"
    conda:
        "envs/env.yml"
    shell:
        """
        if [ "$(awk 'END {{print NR}}' {input.fasta})" -eq 1 ]; then
            touch {output.txt} {output.pdf}
        else
            picard CollectInsertSizeMetrics \
                I={input.sorted_rg_bam} \
                O={output.txt} \
                H={output.pdf} \
                M=0.5 > {log} 2>&1
        fi
        """    


rule run_picard_read_groups:
    message: "Get read groups using Picard"
    input:
        fasta         = "{sample}/02_assembly/{sample}.fasta",
        sorted_rg_bam = "{sample}/02_assembly/{sample}_ref.sorted.rg.bam",
    output:
        bam           = temp("{sample}/02_assembly/{sample}_ref.sorted.rg.fixed.bam")
    params:
        insample      = "{sample}"
    log:
        "logs/{sample}/02_assembly/12_picard-read-groups.snakemake.log"
    conda:
        "envs/env.yml"
    shell:
        """
        if [ "$(awk 'END {{print NR}}' {input.fasta})" -eq 1 ]; then
            touch {output.bam}
        else
            picard AddOrReplaceReadGroups \
                I={input.sorted_rg_bam} \
                O={output.bam} \
                RGID=rg1 \
                RGLB=lib1 \
                RGPL=ILLUMINA \
                RGPU=unit1 \
                RGSM={params.insample}
        fi
        """


rule run_picard_duplicates:
    message: "Run Picard duplicates"
    input:
        fasta =  "{sample}/02_assembly/{sample}.fasta",
        bam   = "{sample}/02_assembly/{sample}_ref.sorted.rg.fixed.bam",
        pdf   = "{sample}/02_assembly/{sample}_insert_size_histogram.pdf",
    output:
        bam   = temp("{sample}/02_assembly/{sample}_marked_duplicates.bam"),
        txt   = temp("{sample}/02_assembly/{sample}_marked_dup_metrics.txt")
    log:
        "logs/{sample}/02_assembly/13_picard-duplicates.snakemake.log"
    conda:
        "envs/env.yml"
    shell:
        """
        if [ "$(awk 'END {{print NR}}' {input.fasta})" -eq 1 ]; then
            touch {output.txt} {output.bam}
        else
            picard MarkDuplicates \
                I={input.bam} \
                O={output.bam} \
                M={output.txt} > {log} 2>&1
        fi
        """


rule run_picard_alignment_metrics:
    message: "Get alignment metrics using Picard"
    input:
        fasta = "{sample}/02_assembly/{sample}.fasta",
        bam   = "{sample}/02_assembly/{sample}_ref.sorted.rg.fixed.bam",
        txt   = "{sample}/02_assembly/{sample}_marked_dup_metrics.txt"
    output:
        txt   = temp("{sample}/02_assembly/{sample}_picard_output.txt")
    log:
        "logs/{sample}/02_assembly/14_picard-alignment-metrics.snakemake.log"
    conda:
        "envs/env.yml"
    shell:
        """
        if [ "$(awk 'END {{print NR}}' {input.fasta})" -eq 1 ]; then
            touch {output.txt}
        else
            picard CollectAlignmentSummaryMetrics \
                R={input.fasta} \
                I={input.bam} \
                O={output.txt} > {log} 2>&1
        fi
        """


rule compute_coverage:
    message: "Use ref BAM to get coverage per FASTA header"
    input:
        bam      = "{sample}/02_assembly/{sample}_ref.sorted.rg.bam",
        txt      = "{sample}/02_assembly/{sample}_picard_output.txt"
    output:
        coverage = "{sample}/03_qualityControl/{chromosomes}_coverage.txt"
    params:
        chrs     = "{chromosomes}"
    log:
        "logs/{sample}/03_qualityControl/01_{chromosomes}.coverage.log"
    conda:
        "envs/env.yml"
    shell:
        """
        samtools depth -aa {input.bam} -r {params.chrs} > {output.coverage} 2> {log}
        """


