##########
# IMPORT #
##########

import pandas as pd
from snakemake.utils import min_version
min_version("9.0.0")

##########
# CONFIG #
##########

configfile: "config.yaml"
mappings  = pd.read_csv(config["samples"])
sampleids = mappings["Sample_ID"].tolist()

########
# DEF #
########

reference   = config['reference_genome'] 
chromosomes = config['ref_fasta_headers']

#########
# RULES #
#########


rule all:
    input:
        txt = "workflow_summary.txt"


rule file_rename:
    message: "Rename input folder for consistency"
    input:
        R1 = "{sample}/{sample}/{sample}_1.fastq.gz",
        R2 = "{sample}/{sample}/{sample}_2.fastq.gz",
    output:
        R1 = "{sample}/01_fastqs/{sample}_1.fastq.gz",
        R2 = "{sample}/01_fastqs/{sample}_2.fastq.gz"
    log:
        "logs/{sample}/01_rename/01_rename-fastqs.snakemake.log"
    shell:
        """
        mv {input.R1} {output.R1}
        mv {input.R2} {output.R2}
        rm -rf {wildcards.sample}/{wildcards.sample}
        """


rule run_cutadapt:
    message: "Trim primers using cutadapt"
    input:
        R1 = "{sample}/01_fastqs/{sample}_1.fastq.gz",
        R2 = "{sample}/01_fastqs/{sample}_2.fastq.gz"
    output:
        R1 = "{sample}/02_assembly/reads.1.fastq.gz",
        R2 = "{sample}/02_assembly/reads.2.fastq.gz"
    log:
        "logs/{sample}/02_assembly/01_run-cutadapt.snakemake.log"
    conda: 
        "envs/env.yml"
    shell:
        """
        cutadapt \
            -g file:{config[forward_primer]} \
            -a file:{config[reverse_primer]} \
            -G file:{config[forward_primer]} \
            -A file:{config[reverse_primer]} \
            -o {output.R1} -p {output.R2} \
            {input.R1} {input.R2} > {log} 2>&1
        """

    
rule run_fastqc:
    message: "Run FASTQC on FASTQs"
    input:
        R1 = "{sample}/02_assembly/reads.1.fastq.gz",
        R2 = "{sample}/02_assembly/reads.2.fastq.gz"
    output:
        R1 = "{sample}/02_assembly/reads.1_fastqc.html",
        R2 = "{sample}/02_assembly/reads.2_fastqc.html"
    log:
        "logs/{sample}/02_assembly/02_run-fastqc.snakemake.log"
    conda:
        "envs/env.yml"
    shell:
        """
        fastqc --nogroup {input.R1} {input.R2} --outdir $(dirname {output.R1}) > {log} 2>&1
        """


rule minimap2_clip:
    message: "Align reads to reference, clip, and generate final BAM"
    input:
        fR2 = "{sample}/02_assembly/reads.2_fastqc.html",
        cR1 = "{sample}/02_assembly/reads.1.fastq.gz",
        cR2 = "{sample}/02_assembly/reads.2.fastq.gz"
    output:
        bam = "{sample}/02_assembly/{sample}_ref.bam",
        bai = "{sample}/02_assembly/{sample}_ref.bam.bai"
    log:
        "logs/{sample}/02_assembly/03_minimap2-clip.snakemake.log"
    conda: 
        "envs/env.yml"
    shell:
        r"""
        # Align and sort
        minimap2 -t {threads} -ax sr {config[reference_genome]} {input.cR1} {input.cR2} 2>> {log} \
            | samtools sort -@ {threads} -o {output.bam} >> {log} 2>&1
        
        samtools index {output.bam} >> {log} 2>&1

        # Create clipped BAM (remove soft-clipped reads)
        samtools view -h {output.bam} \
            | awk '$6 !~ /S/' \
            | samtools view -b - > {output.bam}.tmp

        mv {output.bam}.tmp {output.bam}
        samtools index {output.bam} >> {log} 2>&1
        """


rule sorted_bam:
    message: "Generate fully sorted BAM"
    input:
        bam = "{sample}/02_assembly/{sample}_ref.bam"
    output:
        bam = "{sample}/02_assembly/{sample}_ref.sorted.bam"
    log:
        "logs/{sample}/02_assembly/04_sort-bam.snakemake.log"
    conda:
        "envs/env.yml"
    shell:
        """
        samtools sort -o {output.bam} {input.bam} >> {log} 2>&1
        samtools index {output.bam} >> {log} 2>&1
        """


rule group_reads_in_bam:
    message: "Run samtools to group reads in BAM file"
    input:
        sorted_bam    = "{sample}/02_assembly/{sample}_ref.sorted.bam"
    output:
        sorted_rg_bam = "{sample}/02_assembly/{sample}_ref.sorted.rg.bam",
        sorted_rg_bai = "{sample}/02_assembly/{sample}_ref.sorted.rg.bam.bai"
    log:
        "logs/{sample}/02_assembly/05_read-group-bam.snakemake.log"
    conda:
        "envs/env.yml"
    shell:
        """
        samtools addreplacerg -r '@RG\tID:1\tSM:sample\tPL:ILLUMINA' -o {output.sorted_rg_bam} {input.sorted_bam} >> {log} 2>&1
        samtools index {output.sorted_rg_bam} >> {log} 2>&1
        """

