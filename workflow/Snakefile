#!/usr/bin/env snakemake

##########
# IMPORT #
##########

import os
import glob
import pandas as pd
from snakemake.utils import min_version
from datetime import datetime
min_version("9.0.0")

#############
# FUNCTIONS #
#############

# Function to find the barcode file for this run
def get_barcode_file():
    # 1. Check if user provided a specific file in config
    conf_val = config.get("barcodes_file")
    if conf_val:
        return conf_val
    
    # 2. If not, search for any csv
    found_files = glob.glob("*.csv")
    if found_files:
        return found_files[0]
    
    # 3. Fallback or Error
    raise ValueError("No barcode file provided in config and no .csv found in directory.")
    

##########
# CONFIG #
